# SwayWM idle/lock configuration. For detailed information type "man sway-idle"
# Author: Oscar Carballal Prego <oscar.carballal@protonmail.com>

# Lock screen image = the current Bing wallpaper (changed daily with $mod+Alt+Up).
# -c is the fallback color if the image is missing (e.g. a brand-new PC).
set $lockscreenbg ~/Pictures/Wallpapers/actual.jpg -s fill -c 0d1640

exec swayidle -w \
    timeout 600 'swaylock -f -i $lockscreenbg' \
    timeout 900 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -i $lockscreenbg'

# Lock the screen: no keybinding (Super+L freed), type `block` in a terminal (zshrc alias).

# Lid: lock and switch off the internal screen when closed, back on when opened.
# On AC power logind ignores the lid (module "lid"), so running jobs keep going.
bindswitch --reload --locked lid:on output $display_laptop power off, exec swaylock -f -i $lockscreenbg
bindswitch --reload --locked lid:off output $display_laptop power on

# Never lock/blank while any window is fullscreen (YouTube, films...).
# Firefox also inhibits idle by itself while a video is playing.
for_window [shell=".*"] inhibit_idle fullscreen
# ...and while any audio is playing (video not in fullscreen).
exec ~/.config/sway/scripts/audio-idle-inhibit.sh
