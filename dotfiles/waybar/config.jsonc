{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "margin-top": 0,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": [
        "sway/workspaces"
    ],

    "modules-center": [
        "sway/window"
    ],

    "modules-right": [
        "keyboard-state",
        "custom/ping",
        "network",
        "tray",
        "memory",
        "battery",
        "custom/date",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}",
        "persistent-workspaces": {}
    },

    "sway/window": {
        "max-length": 60,
        "tooltip": false
    },

    "keyboard-state": {
        "numlock": false,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        },
    },

    "custom/ping": {
        "exec": "ping -c 1 -W 2 1.1.1.1 2>/dev/null | tail -1 | awk -F'/' '{printf \"󱘖  %.0f ms\", $5}' || echo '󱘖  --'",
        "interval": 10,
        "format": "{}",
        "tooltip": false
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  {ipaddr}",
        "format-disconnected": "󰖪  disconnected",
        "tooltip-format": "{ifname}: {ipaddr}\n{gwaddr} — {signalStrength}%\n{frequency} MHz",
        "interval": 5
    },

    "tray": {
        "icon-size": 16,
        "spacing": 4,
        "show-passive-items": true,
        "tooltip": false
    },

    "memory": {
        "interval": 5,
        "format": "󰍛  {percentage}%",
        "tooltip-format": "Used: {used:0.1f}G / {total:0.1f}G",
        "warning": 75,
        "critical": 90
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    "custom/date": {
        "exec": "date '+  %d/%m/%Y'",
        "interval": 60,
        "format": "{}",
        "tooltip": false
    },

    "clock": {
        "interval": 1,
        "format": "  {:%H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
