" Alt+↑ / Alt+↓ : déplacer la ligne courante (ou la sélection) d'un cran.
" Dans un terminal, Alt+flèche arrive comme CSI « 1;3 A/B » (kitty, xterm, tmux…).
" Déclarer « <xUp>/<xDown> » avec le pattern « [@;*X » (voir :help arrow_modifiers)
" fait reconnaître la séquence ET son modificateur : « ;3 » = Alt → <M-Up>/<M-Down>.
" (« set <M-Up>=… » ne marche pas : E518.) « @ » couvre aussi la flèche sans modificateur.
if !has('gui_running')
  execute "set <xUp>=\e[@;*A"
  execute "set <xDown>=\e[@;*B"
endif

nnoremap <silent> <M-Up>   :move .-2<CR>==
nnoremap <silent> <M-Down> :move .+1<CR>==
inoremap <silent> <M-Up>   <Esc>:move .-2<CR>==gi
inoremap <silent> <M-Down> <Esc>:move .+1<CR>==gi
" En visuel, « : » pré-remplit « '<,'> » : on garde le range pour déplacer toute la sélection.
vnoremap <silent> <M-Up>   :move '<-2<CR>gv=gv
vnoremap <silent> <M-Down> :move '>+1<CR>gv=gv

" <leader>m : aperçu « lisible » du markdown (glow) dans un split à droite — toggle.
nnoremap <silent> <leader>m :call ToggleGlow()<CR>
function! ToggleGlow() abort
  " Une fenêtre d'aperçu est déjà ouverte ? -> on la ferme.
  for l:w in range(1, winnr('$'))
    if getbufvar(winbufnr(l:w), 'glow_preview', 0)
      execute l:w . 'wincmd w'
      close!  " « ! » : le job (glow/pager) tourne encore (sinon E948)
      return
    endif
  endfor
  if !executable('glow')
    echohl WarningMsg | echom 'glow introuvable — module cli-extra de pc_conf_build' | echohl None
    return
  endif
  let l:file = expand('%:p')
  if empty(l:file)
    echohl WarningMsg | echom 'glow : buffer sans nom de fichier' | echohl None
    return
  endif
  " « :terminal » ouvrirait encore un split : on split nous-mêmes en vertical.
  execute 'rightbelow terminal glow ' . fnameescape(l:file)
  let b:glow_preview = 1
endfunction
