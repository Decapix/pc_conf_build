# cpr : copie stdin (ou des fichiers) dans le presse-papier — ex: cat xx.txt | cpr
cpr() {
  if [[ -n $WAYLAND_DISPLAY ]]; then
    cat "$@" | wl-copy
  else
    cat "$@" | xclip -selection clipboard
  fi
}

