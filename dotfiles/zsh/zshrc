# pwdc / cdc - quick save and jump to a directory
function pwdc() {
  pwd > "$HOME/.pwdc_output"
  if [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-copy >/dev/null; then
    pwd | tr -d '\n' | wl-copy
  elif command -v xclip >/dev/null; then
    pwd | tr -d '\n' | xclip -selection clipboard
  fi
  echo "Saved & copied: $(pwd)"
}

# readlinkfc <fichier> - copie le chemin absolu d'un fichier dans le presse-papier
function readlinkfc() {
  if [[ -z "$1" ]]; then
    echo "Usage: readlinkfc <fichier>"
    return 1
  fi
  if [[ ! -e "$1" ]]; then
    echo "readlinkfc: '$1' introuvable"
    return 1
  fi
  local abspath
  abspath="$(readlink -f "$1")" || return
  if [[ -n "$WAYLAND_DISPLAY" ]] && command -v wl-copy >/dev/null; then
    printf '%s' "$abspath" | wl-copy
  elif command -v xclip >/dev/null; then
    printf '%s' "$abspath" | xclip -selection clipboard
  fi
  echo "Copied: $abspath"
}

function cdc() {
  if [[ -f "$HOME/.pwdc_output" ]]; then
    cd "$(cat "$HOME/.pwdc_output")" || return
  else
    echo "No saved location. Run pwdc first."
  fi
}

