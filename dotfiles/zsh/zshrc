# ranger_cd
ranger_cd() {
    tempfile=$(mktemp)
    ranger --choosedir="$tempfile" "$@"
    if [ -f "$tempfile" ]; then
        target=$(cat "$tempfile")
        if [ -n "$target" ] && [ -d "$target" ]; then
            cd "$target" || return
        fi
    fi
    rm -f "$tempfile"
}

