# Enregistre le micro en MP3 dans le dossier courant (q ou Ctrl+C pour arrêter)
# mic → enregistrement-AAAAMMJJ-HHMMSS.mp3 ; mic nom → nom.mp3
mic() {
  local f="${1:-enregistrement-$(date +%Y%m%d-%H%M%S)}.mp3"
  ffmpeg -hide_banner -loglevel warning -stats \
    -f pulse -i default -ac 1 -c:a libmp3lame -q:a 2 "$f" && echo "→ $f"
}
